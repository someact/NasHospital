# Core Django Settings
SECRET_KEY=replace-with-a-secure-random-64-character-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,medresearch.hospital.internal

# Hospital Domain (embedded in canvas watermark stamps)
HOSPITAL_DOMAIN=medresearch.hospital.internal

# Zero Plaintext Storage Master Encryption Key (Fernet 32-byte urlsafe base64 key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=uK8wJzFq1-3Lq6tB5_zZ0XyP_sO7uR9vE2mN4kC8wA=

# Database Configuration (PostgreSQL in production, SQLite in development)
DATABASE_URL=postgres://postgres:password@db:5432/medresearch_dms
POSTGRES_DB=medresearch_dms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Email / Notification Delivery (Mailpit in demo/staging, SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=medresearch-dms@hospital.internal
